{
  "expo": {
    "name": "ShelfZero",
    "slug": "shelfzero",
    "scheme": "shelfzero",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shelfzero.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ShelfZero uses your camera to scan receipts and barcodes so items can be added to your pantry automatically."
      }
    },
    "android": {
      "package": "com.shelfzero.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#707156"
      },
      "permissions": [
        "CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "shelfzero",
              "host": "join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "apiBaseUrl": "https://rs1ilxb2il.c24.airoapp.ai",
      "eas": {
        "projectId": "f003dbc0-9595-4d33-8bb9-f3bee0d1911b"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#707156"
        }
      ]
    ],
    "owner": "laasyass-team"
  }
}
